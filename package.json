{
  "name": "open-builder",
  "description": "Open Builder is an open-source AI-powered app generator. Build web applications through natural language conversations.",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "engines": {
    "node": ">=24 <26",
    "pnpm": ">=10 <12"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:check": "node scripts/check-build-artifacts.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:debug": "tauri build --debug",
    "tauri:ios:dev": "tauri ios dev",
    "tauri:ios:build": "tauri ios build",
    "tauri:android:dev": "tauri android dev",
    "tauri:android:build": "tauri android build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts e2e vite.config.ts playwright.config.ts eslint.config.js --max-warnings=0",
    "format:check": "prettier --check --no-error-on-unmatched-pattern \"src/{App,main}.tsx\" \"src/index.css\" \"src/components/{AppLayout*,ChatInterface*,CodeViewer}.tsx\" \"src/components/chat/{AskUserQuestionCard*,ChatInput,DiffModal*,GeneratingIndicator*,LazyMarkdownContent,MessageBubble*,PlanApprovalCard}.tsx\" \"src/components/chat/{ProjectImportDialog*,ProjectTemplateDialog,ResetProjectConfirmDialog*,SessionListOverlay*,SnapshotHistoryDialog,SubagentCallCard,ToolCallCard*}.tsx\" \"src/components/chat/chat-input/{AttachmentPreview,ChatInputToolbar*,McpMenu,SkillsMenu,SlashCommandMenu*}.tsx\" \"src/components/chat/session-list/SessionItem.tsx\" \"src/components/code-viewer/{FileExplorer,SandpackListener,ViewToolbar*,sandpack-file-changes*}.{ts,tsx}\" \"src/components/design/*.tsx\" \"src/components/mcp/**/*.tsx\" \"src/components/settings/{SettingsDialog*,tabs/AdvancedTab,tabs/LocalAgentSettings*,tabs/ModelTab*,tabs/StorageTab,tabs/SystemTab}.tsx\" \"src/components/skills/SkillCard.tsx\" \"src/components/ui/{capsule-group*,tooltip,tooltip-icon-button}.tsx\" \"src/hooks/{useAppLayout*,useAppState,useGenerator,useTitleAndCompression}.ts\" \"src/i18n/{en,zh}.ts\" \"src/lib/app-version.ts\" \"src/lib/ai/{ask-user-question-contract*,client,conversation-context*,custom-system-prompt*,generator*,messages*,plan-mode*,project-guidelines*,provider-config*,run-system-prompt*,tool-policy-version,tools-schema*}.ts\" \"src/lib/ai/subagents/**/*.ts\" \"src/lib/design/**/*.ts\" \"src/lib/design-systems/**/*.{ts,json}\" \"src/lib/{attachments,infra,local-agent,mcp,runtime,security,storage}/**/*.ts\" \"src/lib/skills/{active-context,display-text,import-limits,importer*,instance,manifest,parser,paths,registry,script-execution-guard*,script-executor*,text-creator,tool-handler*}.ts\" \"src/lib/tools/{advanced-write-tools.test,console-log-format*,design-style*,design-styles,fs-tools*,handler-factory,install-component,network-guard*,project-health*,sandpack-template-manifest*}.ts\" \"src/lib/utils/{attachments*,compress-context*,merge-messages,message-security*,project-file-policy*,project-files*,project-import*,smart-title,tool-result}.ts\" \"src/store/{conversation*,design-*,mcp*}.ts\" \"src/store/settings/{ai,migrations*,system}.ts\" \"src/test/setup.ts\" \"src/types/index.ts\" \"src-tauri/capabilities/*.json\" \"public/mcp/**/*.html\" \"scripts/**/*.mjs\" \"e2e/**/*.ts\" \"*.{json,ts,js,md}\" \"docs/*.md\" \".github/workflows/*.{yml,yaml}\"",
    "test": "pnpm test:frontend && pnpm test:rust",
    "test:frontend": "vitest run",
    "test:rust": "cargo test --locked --manifest-path src-tauri/Cargo.toml",
    "test:components": "vitest run src/components",
    "test:e2e:design": "playwright test e2e/design-mode.spec.ts",
    "security:desktop": "node scripts/check-desktop-security.mjs",
    "workflow:check": "node scripts/check-workflows.mjs && node --test scripts/extract-release-notes.test.mjs scripts/prepare-macos-signing.test.mjs",
    "version:sync": "node scripts/version-contract.mjs --write",
    "version:check": "node scripts/version-contract.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.41",
    "@ai-sdk/google": "^4.0.50",
    "@ai-sdk/openai": "^4.0.46",
    "@ai-sdk/openai-compatible": "^3.0.35",
    "@codesandbox/nodebox": "0.1.8",
    "@codesandbox/sandpack-client": "2.19.8",
    "@codesandbox/sandpack-react": "^2.20.0",
    "@modelcontextprotocol/client": "^2.0.0",
    "@tanstack/react-virtual": "^3.14.10",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "ai": "^7.0.77",
    "ajv": "^8.20.0",
    "browser-image-compression": "2.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "diff": "^9.0.0",
    "file-saver": "^2.0.5",
    "highlight.js": "^11.12.0",
    "html-to-image": "1.11.13",
    "html2canvas": "1.4.1",
    "js-yaml": "^5.3.0",
    "jszip": "^3.10.1",
    "localforage": "^1.10.0",
    "lucide-react": "^1.33.0",
    "material-icon-theme": "^5.38.1",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.12.3",
    "rehype-highlight": "^7.0.2",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "semver": "7.8.5",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/semver": "^7.8.0",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^10.9.0",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "shadcn": "^4.19.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "vitest-axe": "^0.1.0"
  }
}
